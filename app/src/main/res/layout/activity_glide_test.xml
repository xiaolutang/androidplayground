<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glide 内存验证实验"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试原图: 50x50 像素的小方块"
            android:textColor="#666666"
            android:layout_marginBottom="16dp"/>

        <!-- 对照组 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配置1: 普通加载 (wrap_content)"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#DDDDDD" />
                <TextView
                    android:id="@+id/tvNormalInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="等待加载..."
                    android:textColor="#1B5E20"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 实验组 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:strokeColor="#B00020"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配置2: centerCrop (wrap_content)"
                    android:textColor="#B00020"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivCenterCrop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#DDDDDD" />
                <TextView
                    android:id="@+id/tvCenterCropInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="等待加载..."
                    android:textColor="#B00020"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- XML 方案组 (原有) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配置3: XML ScaleType (100x100)"
                    android:textColor="#388E3C"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivXmlCrop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scaleType="centerCrop"
                    android:background="#DDDDDD" />
                <TextView
                    android:id="@+id/tvXmlCropInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="等待加载..."
                    android:textColor="#388E3C"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 200dp 实验组 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="固定尺寸: 200dp x 200dp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivFixed200"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="#DDDDDD" />
                <TextView
                    android:id="@+id/tvFixed200Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="等待加载..."
                    android:textColor="#1976D2"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 500dp 实验组 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="固定尺寸: 500dp x 500dp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivFixed500"
                    android:layout_width="500dp"
                    android:layout_height="500dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="#DDDDDD" />
                <TextView
                    android:id="@+id/tvFixed500Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="等待加载..."
                    android:textColor="#F57C00"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="开始加载对比"/>

    </LinearLayout>
</ScrollView>
